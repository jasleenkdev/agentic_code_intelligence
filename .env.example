# All variables are optional. Empty = built-in default (local, free, CPU-only). Never commit .env.

# ---- Target repo / index ----
CODEINTEL_REPO=
CODEINTEL_INDEX_DIR=
# comma-separated dirs under the repo to index (default: server,front/src)
CODEINTEL_INCLUDE=

# ---- LLM: any OpenAI-compatible endpoint. Default = local Ollama, no key needed ----
# Groq free tier example:   LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.1-8b-instant
# Gemini free tier example: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.0-flash
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_FALLBACK_MODEL=
# Ollama only: 0 = force CPU (default, hackathon constraint); -1 = let Ollama use the GPU
LLM_NUM_GPU=
LLM_TIMEOUT_SEC=
LLM_MAX_TOKENS=
LLM_NUM_CTX=

# ---- Local models (downloaded into ./.hf_cache) ----
EMBED_MODEL=
# plain | enriched (default)
EMBED_TEXT=
EMBED_QUERY_PREFIX=
EMBED_MAX_SEQ=
RERANK_MODEL=
WHISPER_MODEL=
TORCH_THREADS=

# ---- Snippet-library code search (src/codesearch) ----
# Embedding model key for codebase libraries (default gte-modernbert; see encoders.PROFILES)
CODESEARCH_CODEBASE_MODEL=
# Override locations of the embedding cache / chunk cache / versioned indexes (default under index/)
CODESEARCH_EMB_CACHE=
CODESEARCH_CHUNK_CACHE=
CODESEARCH_VERSIONS_DIR=
# 0 = do not warm the APPS library and query encoders when the API starts (default 1)
CODESEARCH_WARM=
# MTEB result cache (./run.sh submit always uses a fresh .cache/mteb_run)
MTEB_CACHE=

# ---- Gladys agent ----
# 1 = stream the optional LLM explanation by default (generation is out of scope; default off)
CODEINTEL_EXPLAIN=
